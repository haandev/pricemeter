{
  "name": "pricemeter-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.typetests.json",
    "test:bench-types": "node scripts/type-budget.mjs",
    "typecheck": "tsc -b",
    "coverage": "vitest run --coverage",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "test:examples-types": "tsc -p examples/llm-gateway && tsc -p examples/saas-seats && tsc -p examples/messaging"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "arktype": "^2.2.5",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
