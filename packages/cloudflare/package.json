{
  "name": "pricemeter-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare reference adapter for pricemeter: per-account Durable Object ledger (SQLite storage) with a D1 usage sink.",
  "license": "MIT",
  "author": "Hakan Özoğlu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haandev/pricemeter.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://haandev.github.io/pricemeter/",
  "keywords": [
    "pricemeter",
    "cloudflare",
    "durable-objects",
    "d1",
    "metering",
    "ledger"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "pricemeter": "^0.1.0"
  },
  "devDependencies": {
    "pricemeter": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
